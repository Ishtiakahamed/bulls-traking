# Bulls Traking Phase 1 Environment Variables

PORT=5000
NODE_ENV=development
PRIMARY_PROVIDER=coinmarketcap

# Market Data Providers (Optional - public endpoints used by default)
# CoinGecko options:
COINGECKO_API_KEY=
# COINGECKO_PRO_API_KEY=     # For paid Pro API (uses pro-api.coingecko.com)
# COINGECKO_DEMO_API_KEY=    # For free registered Demo API key
# COINGECKO_PLAN=pro         # 'pro' or 'demo'

# CoinMarketCap options:
COINMARKETCAP_API_KEY=

# Sync Interval in Milliseconds (default 60000ms = 60s)
SYNC_INTERVAL_MS=60000

# Database URL for PostgreSQL (optional for local SQLite development)
DATABASE_URL=
REDIS_URL=

# Telegram-primary immutable order ledger
# Never commit real values. The bot must be an administrator of the private group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIMARY_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Set true in production after the bot and private group are configured.
TELEGRAM_PRIMARY_REQUIRED=false
