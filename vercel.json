{
  "version": 2,
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!api|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
